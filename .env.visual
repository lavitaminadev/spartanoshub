# Modo visual: la interfaz corre sin backend, con la sesión abierta y todos los módulos
# visibles. Lo consume `src/dev/visual-mode.ts`, que intercepta axios para que ninguna
# petición salga a la red. Vite solo carga este archivo con `--mode visual`, así que un
# `npm run dev` normal sigue hablando con la API real.
VITE_VISUAL=1
