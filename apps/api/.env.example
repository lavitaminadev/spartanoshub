NODE_ENV=production
PORT=3000

# MySQL - iHosting/cPanel Production
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=espartanos_user
DB_PASSWORD=change_this_to_secure_password
DB_DATABASE=espartanos_prod
DB_LOGGING=false
DB_SSL=false
DB_CONNECTION_LIMIT=5

# Public URLs and browser access
# Production/iHosting example:
CORS_ORIGIN=https://cuartel.espartanos.cl
APP_PUBLIC_URL=https://cuartel.espartanos.cl
API_PUBLIC_URL=https://refugio.espartanos.cl/api
# Read at build time by the frontend. `check:production-env` requires VITE_API_URL to be an
# absolute URL and to match API_PUBLIC_URL exactly.
VITE_API_URL=https://refugio.espartanos.cl/api
# Public origin of the frontend, used to build the reservation links shared in ads.
VITE_APP_PUBLIC_URL=https://cuartel.espartanos.cl
ENABLE_SWAGGER=false
ALLOW_PUBLIC_REGISTRATION=false
TRUST_PROXY_HOPS=1
# Passenger puede levantar más de un proceso y cada uno tendría sus propios timers. En cPanel
# deja esto apagado y programa los endpoints protegidos en Cron Jobs: es el único modo de tener
# una hora de ejecución definida y una sola pasada por tarea.
ENABLE_INTERNAL_SCHEDULER=false

# Authentication and encrypted integration credentials
JWT_SECRET=generate_a_long_random_string_here_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Shared secret for the cron endpoints that process the conversion queues.
# Usa una cadena base64url o hexadecimal de 32-128 caracteres, sin espacios.
CRON_SECRET=generate_a_long_random_string_here_minimum_32_characters
BCRYPT_ROUNDS=12
# Exactamente 32 bytes: usa `openssl rand -hex 32`.
INTEGRATION_ENCRYPTION_KEY=replace_with_64_hex_characters
OAUTH_STATE_SECRET=generate_another_random_string_here

# Private file storage (outside public_html for security)
UPLOAD_DIR=/home/espartanoscl/espartanos_uploads
MAX_UPLOAD_BYTES=20971520

# Performance & Monitoring
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_for_production_errors
SENTRY_ENVIRONMENT=production
ENABLE_SLOW_QUERY_LOGGING=true
ENABLE_WEBHOOK_LOGGING=true
ENABLE_AUDIT_TRAIL=true

# Pagination Settings
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Rate Limiting
# El contador vive en memoria de cada proceso: el limite real por IP es THROTTLE_LIMIT
# multiplicado por la cantidad de procesos de Passenger.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Conexiones a MySQL POR PROCESO. El total es este numero por la cantidad de procesos, y
# debe caber en el max_connections del servidor.
DB_CONNECTION_LIMIT=10

# Cloudinary (optional; enables image uploads for logos/backgrounds)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MAX_IMAGE_BYTES=5242880

# Cuantos dias se conservan los datos personales de un prospecto antes de revisarlos.
#
# Si no se pone, rigen 730 dias (24 meses). No se puede dejar sin plazo: la ley no admite
# conservar datos personales indefinidamente, y una variable ausente no puede significar
# «para siempre».
#
# Llegado el plazo no se borra nada por si solo: se anonimiza lo que ya no tiene fundamento.
# Una venta queda fuera, porque la relacion comercial es ese fundamento.
CRM_LEAD_RETENTION_DAYS=730

# Correo saliente (cuenta de cPanel)
#
# Con SMTP_ENABLED en false no sale ningún correo, aunque el aviso esté encendido en la
# pantalla de Correos. Es el interruptor general y la causa más frecuente de «no me llegó».
#
# El puerto 465 va con SMTP_SECURE=true. La alternativa es 587 con STARTTLS, que cPanel
# ofrece como no recomendada: si se usa, hay que poner SMTP_SECURE=false.
#
# La contraseña va entre comillas simples. Las de cPanel traen símbolos —`;`, `%`, `}`— y sin
# comillas cualquier cambio del lector de variables puede partir el valor por la mitad, con el
# resultado de una autenticación que falla sin decir por qué.
SMTP_ENABLED=true
SMTP_HOST=mail.espartanos.cl
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=crm@espartanos.cl
SMTP_PASSWORD='la-contraseña-de-esa-cuenta'
SMTP_FROM=crm@espartanos.cl
# A dónde contesta quien recibe. Tiene que ser un buzón que alguien lea: un correo de
# seguimiento cuya respuesta se pierde es peor que no haberlo mandado.
SMTP_REPLY_TO=crm@espartanos.cl

# CRM comercial de la agencia (Dominio B): id de la organización propia de La Vitamina,
# a la que se guardan los leads del formulario público /public/agency-crm/leads/submissions.
# Sin esta variable, ese endpoint responde 403 en vez de aceptar leads sin saber a qué
# organización pertenecen.
AGENCY_ORGANIZATION_ID=

# Meta API Integration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=generate_a_random_token_here
META_TEST_EVENT_CODE=
META_CONVERSIONS_ACCESS_TOKEN=your_meta_conversions_token

# Google Integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DEVELOPER_TOKEN=your_google_developer_token
GOOGLE_LOGIN_CUSTOMER_ID=your_google_customer_id
GOOGLE_ADS_API_VERSION=v24

# Redis (Optional - recommended for production caching)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Optional internal conversation service
CONVERSATION_SERVICE_URL=
INTERNAL_API_TOKEN=

# Security Headers
HELMET_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
