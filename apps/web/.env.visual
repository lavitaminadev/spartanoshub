# Modo visual: interfaz sin backend, para revisar vistas.
#
# Lo carga `npm run dev:visual`. Con esta bandera, `src/dev/visual-mode.ts` intercepta axios y
# ninguna petición sale a la red: las pantallas se dibujan con sus estados vacíos reales, sin
# datos inventados y sin necesidad de base de datos.
#
# Para revisar desde otro cargo, agrega `?rol=` a la dirección:
#   http://localhost:5176/crm?rol=commercial_director
VITE_VISUAL=1
